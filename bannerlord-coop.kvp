Meta.DisplayName=Bannerlord Coop Dedicated Server
Meta.Description=Mount & Blade II: Bannerlord Coop mod dedicated server, run under Wine on Linux. Installs and updates itself from the Steam Workshop via SteamCMD.
Meta.OS=Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=YourName
Meta.URL=https://github.com/Bannerlord-Coop-Team/BannerlordCoop
Meta.DisplayImageSource=steam:261550
Meta.EndpointURIFormat=
Meta.ConfigManifest=bannerlord-coopconfig.json
Meta.MetaConfigManifest=bannerlord-coopmetaconfig.json
Meta.ConfigRoot=bannerlord-coop.kvp
Meta.MinAMPVersion=2.4.0.6
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.ContainerPolicy=RecommendedOnLinux
Meta.ContainerPolicyReason=The server requires Wine (ideally latest stable from winehq.org) to run on Linux, as BannerlordCoopServer.exe has no native Linux build. Using a container avoids the need to install Wine on the host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.ConfigVersion=2
Meta.AppConfigId=8c2f1e4a-6b3d-4a1e-9f7a-2d5c8e6b1a3f
Meta.AppIsMultiIPAware=False
App.DisplayName=Bannerlord Coop
App.RootDir=./bannerlordcoop/
App.BaseDirectory=./bannerlordcoop/CoopData/DedicatedServer/
App.ExecutableWin=
App.ExecutableLinux=/usr/bin/wine
App.WorkingDir=steamhome/Steam/steamapps/workshop/content/261550/{{WorkshopItemID}}/DedicatedServer
App.LinuxCommandLineArgs=BannerlordCoopServer.exe
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} --no-tui --data-dir "Z:{{$FullBaseDir}}" -p {{$EnginePort}} --region {{Region}} {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all","SteamAppId":"261550"}
App.CommandLineParameterFormat=--{0} {1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=60
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[bannerlord-coopports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=8
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[bannerlord-coopupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.MonitorChildProcessName=^.*dotnet\.exe TaleWorlds\.Starter\.DotNetCore\.dll .*/dedicatedcustomserver {{$EnginePort}} .*$
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^((WARNING|ERROR): Shader.+|Could not find Wine Gecko.*|\d+:err:ole:.*|wine: Read access denied.*|@DS@\{.*\})$
Console.AppReadyRegex=^.*\[DedicatedServer\] SERVING.*$
Console.UserJoinRegex=^.*\[DedicatedServer\] player connecting: peer (?<userid>\d+) from (?<username>\S+)$
Console.UserLeaveRegex=^.*\[DedicatedServer\] player disconnected: peer (?<userid>\d+).*$
Console.UserChatRegex=^$
Console.MetricsRegex=^.*\[DedicatedServer\] pulse: .*players=(?<Players>\d+) parties=(?<Parties>\d+) mapEvents=(?<Map_Events>\d+).*$
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
